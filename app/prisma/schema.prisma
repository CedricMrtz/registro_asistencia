generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Simposium {
  idSimposium             Int                       @id(map: "PK_Simposium") @default(autoincrement())
  nombre                  String                    @db.VarChar(150)
  fecha_comienzo          DateTime                  @db.Date
  fecha_acabado           DateTime                  @db.Date
  capacidad_asistentes    Int
  adminSimposiumID        Int
  AlumnoInscritoSimposium AlumnoInscritoSimposium[]
  Evento                  Evento[]
  AdminSimposium          AdminSimposium            @relation(fields: [adminSimposiumID], references: [adminSimposiumID], onUpdate: NoAction, map: "FK_Simposium_AdminSimposium")
  StaffTrabajaEnSimposium StaffTrabajaEnSimposium[]
}

model Alumno {
  matricula               String                    @id(map: "PK_Alumno") @db.VarChar(15)
  nombre                  String                    @db.VarChar(120)
  telefono                String?                   @db.VarChar(15)
  semestre                Int                       @db.TinyInt
  email                   String                    @unique(map: "UQ_Alumno_Email") @db.VarChar(150)
  nombre_carrera          String                    @db.VarChar(100)
  Carrera                 Carrera                   @relation(fields: [nombre_carrera], references: [nombre_carrera], map: "FK_Alumno_Carrera")
  AlumnoAsistioEvento     AlumnoAsistioEvento[]
  AlumnoInscritoSimposium AlumnoInscritoSimposium[]
}

model AlumnoInscritoSimposium {
  matricula   String    @db.VarChar(15)
  idSimposium Int
  Alumno      Alumno    @relation(fields: [matricula], references: [matricula], map: "FK_AlumnoInscrito_Alumno")
  Simposium   Simposium @relation(fields: [idSimposium], references: [idSimposium], onDelete: Cascade, onUpdate: NoAction, map: "FK_AlumnoInscrito_Simposium")

  @@id([matricula, idSimposium], map: "PK_AlumnoInscritoSimposium")
}

model Carrera {
  nombre_carrera String   @id(map: "PK_Carrera") @db.VarChar(100)
  siglas         String   @unique(map: "UQ_Carrera_Siglas") @db.VarChar(15)
  nombre_escuela String   @db.VarChar(100)
  Alumno         Alumno[]
  Escuela        Escuela  @relation(fields: [nombre_escuela], references: [nombre_escuela], map: "FK_Carrera_Escuela")
}

model Escuela {
  nombre_escuela String    @id(map: "PK_Escuela") @db.VarChar(100)
  ciudad         String    @db.VarChar(80)
  Carrera        Carrera[]
}

model Evento {
  idEvento            Int                   @id(map: "PK_Evento") @default(autoincrement())
  nombreEvento        String                @db.VarChar(150)
  fecha_comienzo      DateTime              @db.DateTime
  fecha_acabado       DateTime              @db.DateTime
  idSimposium         Int
  nombreTipo          String                @db.VarChar(60)
  AlumnoAsistioEvento AlumnoAsistioEvento[]
  Simposium           Simposium             @relation(fields: [idSimposium], references: [idSimposium], onDelete: Cascade, onUpdate: NoAction, map: "FK_Evento_Simposium")
  TipoEvento          TipoEvento            @relation(fields: [nombreTipo], references: [nombreTipo], map: "FK_Evento_TipoEvento")
}

model Staff {
  staffID                 Int                       @id(map: "PK_Staff") @default(autoincrement())
  nombre                  String                    @db.VarChar(120)
  AlumnoAsistioEvento     AlumnoAsistioEvento[]
  StaffTrabajaEnSimposium StaffTrabajaEnSimposium[]
}

model StaffTrabajaEnSimposium {
  idSimposium Int
  staffID     Int
  Simposium   Simposium @relation(fields: [idSimposium], references: [idSimposium], onDelete: Cascade, onUpdate: NoAction, map: "FK_StaffTrabaja_Simposium")
  Staff       Staff     @relation(fields: [staffID], references: [staffID], onDelete: Cascade, onUpdate: NoAction, map: "FK_StaffTrabaja_Staff")

  @@id([idSimposium, staffID], map: "PK_StaffTrabajaEnSimposium")
}

model TipoEvento {
  nombreTipo String   @id(map: "PK_TipoEvento") @db.VarChar(60)
  Evento     Evento[]
}

model AdminSimposium {
  adminSimposiumID Int         @id(map: "PK_AdminSimposium") @default(autoincrement())
  nombre           String      @db.VarChar(120)
  telefono         String      @db.VarChar(15)
  email            String      @unique(map: "UQ_AdminSimposium_Email") @db.VarChar(150)
  Simposium        Simposium[]
}

model AlumnoAsistioEvento {
  idAsistencia  Int       @id(map: "PK_AlumnoAsistioEvento") @default(autoincrement())
  matricula     String    @db.VarChar(15)
  idEvento      Int
  fecha_llegada DateTime  @db.DateTime
  fecha_salida  DateTime? @db.DateTime
  staffID       Int?
  Alumno        Alumno    @relation(fields: [matricula], references: [matricula], map: "FK_AlumnoAsistio_Alumno")
  Evento        Evento    @relation(fields: [idEvento], references: [idEvento], onDelete: Cascade, onUpdate: NoAction, map: "FK_AlumnoAsistio_Evento")
  Staff         Staff?    @relation(fields: [staffID], references: [staffID], onDelete: Cascade, onUpdate: NoAction, map: "FK_AlumnoAsistio_Staff")

  @@index([matricula, idEvento], map: "IX_AlumnoEvento")
}
